{
  "name": "@peter.naydenov/notice",
  "description": "Event emitter - NOTICE",
  "version": "2.6.2",
  "license": "MIT",
  "author": "Peter Naydenov",
  "main": "./src/main.js",
  "type": "module",
  "types": "./types/main.d.ts",
  "files": [
    "src",
    "dist",
    "types",
    "skills",
    "Changelog.md"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./types/main.d.ts",
        "default": "./src/main.js"
      },
      "require": {
        "types": "./types/main.d.cts",
        "default": "./dist/notice.cjs"
      },
      "default": "./src/main.js"
    },
    "./package.json": "./package.json",
    "./dist/*": "./dist/*",
    "./src/*": "./src/*",
    "./skills/*": "./skills/*"
  },
  "scripts": {
    "test": "vitest run",
    "cover": "vitest run --coverage",
    "build": "rollup -c",
    "postbuild": "tsc -p tsconfig.json && node scripts/cts-types.js",
    "bench": "node benchmark/dispatch.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PeterNaydenov/notice"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@vitest/coverage-v8": "^5.0.4",
    "rollup": "^4.64.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "keywords": [
    "events",
    "emitter",
    "publisher",
    "subscriber",
    "pubsub"
  ],
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
